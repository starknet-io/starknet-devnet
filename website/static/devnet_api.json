{
  "openrpc": "1.0.0-rc1",
  "info": {
    "version": "0.1.0",
    "title": "Devnet API",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [],
  "methods": [
    {
      "name": "devnet_impersonateAccount",
      "summary": "Impersonate an account",
      "params": [
        {
          "name": "account_address",
          "description": "The address of the contract to be impersonated",
          "required": true,
          "schema": {
            "title": "Address",
            "$ref": "#/components/schemas/ADDRESS"
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Empty result",
        "schema": {
          "type": "object"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_REQUEST"
        }
      ]
    },
    {
      "name": "devnet_stopImpersonateAccount",
      "summary": "Stop impersonating an account",
      "params": [
        {
          "name": "account_address",
          "description": "The address of the contract which is impersonated",
          "required": true,
          "schema": {
            "title": "Address",
            "$ref": "#/components/schemas/ADDRESS"
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Empty result",
        "schema": {
          "type": "object"
        }
      },
      "errors": []
    },
    {
      "name": "devnet_autoImpersonate",
      "summary": "Automatic account impersonation",
      "params": [],
      "result": {
        "name": "result",
        "description": "Empty result",
        "schema": {
          "type": "object"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_REQUEST"
        }
      ]
    },
    {
      "name": "devnet_stopAutoImpersonate",
      "summary": "Stop automatic account impersonation",
      "params": [],
      "result": {
        "name": "result",
        "description": "Empty result",
        "schema": {
          "type": "object"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_REQUEST"
        }
      ]
    },
    {
      "name": "devnet_dump",
      "summary": "Export the replay journal, optionally writing it to a file",
      "params": [
        {
          "name": "path",
          "description": "Path to a file to dump the state to",
          "required": false,
          "schema": {
            "title": "Path",
            "type": "string"
          }
        },
        {
          "name": "inline",
          "required": false,
          "schema": {
            "type": "boolean"
          },
          "description": "Ignore the startup dump path; an explicit request path still takes precedence"
        }
      ],
      "result": {
        "name": "result",
        "description": "Dumped replay events",
        "schema": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/DUMP_EVENT"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/DUMP_ERROR"
        }
      ]
    },
    {
      "name": "devnet_load",
      "summary": "Replace Devnet state by replaying events from a file or the request",
      "params": [
        {
          "name": "path",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "events",
          "required": false,
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DUMP_EVENT"
            }
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Empty result",
        "schema": {
          "type": "object"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/DUMP_ERROR"
        }
      ],
      "description": "Exactly one of path or events is required. Restart and load invalidate snapshots and clear subscriptions."
    },
    {
      "name": "devnet_snapshot",
      "summary": "Create an in-memory checkpoint of Devnet state",
      "params": [],
      "result": {
        "name": "snapshot_id",
        "description": "Monotonically increasing hexadecimal snapshot identifier",
        "schema": {
          "type": "string",
          "pattern": "^0x[0-9a-f]+$"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INTERNAL_ERROR"
        }
      ]
    },
    {
      "name": "devnet_revert",
      "summary": "Restore an in-memory Devnet checkpoint",
      "params": [
        {
          "name": "snapshot_id",
          "description": "0x-prefixed hexadecimal identifier fitting u64; uppercase digits and leading zeros are accepted",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]+$"
          }
        }
      ],
      "result": {
        "name": "reverted",
        "description": "True restores and consumes this snapshot and all newer snapshots; zero, unknown, consumed, or invalidated IDs return false",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/INVALID_PARAMS"
        },
        {
          "$ref": "#/components/errors/INTERNAL_ERROR"
        },
        {
          "$ref": "#/components/errors/DUMP_ERROR"
        }
      ]
    },
    {
      "name": "devnet_postmanLoad",
      "summary": "Load L1 messaging contract",
      "params": [
        {
          "name": "network_url",
          "description": "URL of running L1 node",
          "required": true,
          "schema": {
            "title": "Network URL",
            "type": "string"
          }
        },
        {
          "name": "messaging_contract_address",
          "description": "Address of an already deployed messaging contract on L1. If specified, no new contract is deployed.",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/ETH_ADDRESS"
          }
        },
        {
          "name": "deployer_account_private_key",
          "description": "The private key of the account that shall be used for deploying the messaging contract. Not applicable if `messaging_contract_address` is specified.",
          "required": false,
          "schema": {
            "title": "Deployer account private key",
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{64}$"
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "The result of L1 contract loading",
        "schema": {
          "type": "object",
          "properties": {
            "messaging_contract_address": {
              "title": "The address of the messaging contract",
              "$ref": "#/components/schemas/ETH_ADDRESS"
            }
          },
          "required": ["messaging_contract_address"]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/MESSAGING_ERROR"
        },
        {
          "$ref": "#/components/errors/INVALID_ADDRESS"
        }
      ]
    },
    {
      "name": "devnet_postmanFlush",
      "summary": "Send/receive all messages from/to L1",
      "params": [
        {
          "name": "dry_run",
          "description": "Optional when params is omitted; required if a params object is supplied",
          "required": false,
          "schema": {
            "title": "Dry run",
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Sent/received messages",
        "schema": {
          "type": "object",
          "properties": {
            "messages_to_l1": {
              "type": "array",
              "title": "Messages to L1",
              "items": {
                "$ref": "#/components/schemas/MSG_TO_L1"
              }
            },
            "messages_to_l2": {
              "type": "array",
              "title": "Messages to L2",
              "items": {
                "$ref": "#/components/schemas/MSG_TO_L2"
              }
            },
            "generated_l2_transactions": {
              "type": "array",
              "title": "Transaction hashes",
              "items": {
                "$ref": "#/components/schemas/FELT"
              }
            },
            "l1_provider": {
              "title": "L1 provider",
              "description": "The provider of the L1 node",
              "type": "string"
            }
          },
          "required": [
            "messages_to_l1",
            "messages_to_l2",
            "generated_l2_transactions",
            "l1_provider"
          ]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/MESSAGING_ERROR"
        }
      ],
      "description": "Only accepted local blocks contribute L2-to-L1 messages. A dry run collects these messages without sending them and does not fetch or execute L1-to-L2 messages."
    },
    {
      "name": "devnet_postmanSendMessageToL2",
      "summary": "Send message L1 to L2",
      "params": [
        {
          "name": "l2_contract_address",
          "required": true,
          "schema": {
            "description": "The address of the L2 contract receiving the message",
            "$ref": "#/components/schemas/ADDRESS"
          }
        },
        {
          "name": "entry_point_selector",
          "required": true,
          "schema": {
            "title": "Selector",
            "description": "The selector of the function in the l2 contract to invoke",
            "$ref": "#/components/schemas/FELT"
          }
        },
        {
          "name": "l1_contract_address",
          "required": true,
          "schema": {
            "description": "The address of the L1 contract sending the message",
            "$ref": "#/components/schemas/ADDRESS"
          }
        },
        {
          "name": "payload",
          "required": true,
          "schema": {
            "description": "The payload of the message",
            "title": "Payload",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FELT"
            }
          }
        },
        {
          "name": "paid_fee_on_l1",
          "required": true,
          "schema": {
            "title": "Paid fee on L1",
            "$ref": "#/components/schemas/FELT"
          }
        },
        {
          "name": "nonce",
          "required": true,
          "schema": {
            "title": "Nonce",
            "$ref": "#/components/schemas/FELT"
          }
        },
        {
          "name": "l1_transaction_hash",
          "required": false,
          "schema": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HASH256"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Hash of the executed L1-handler transaction",
        "schema": {
          "type": "object",
          "properties": {
            "transaction_hash": {
              "description": "Transaction hash of executed message",
              "$ref": "#/components/schemas/FELT"
            }
          },
          "required": ["transaction_hash"]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/MESSAGING_ERROR"
        }
      ]
    },
    {
      "name": "devnet_postmanConsumeMessageFromL2",
      "summary": "Consume a locally emitted L2-to-L1 message without an L1 node",
      "params": [
        {
          "name": "from_address",
          "required": true,
          "schema": {
            "description": "The address of the L2 contract sending the message",
            "$ref": "#/components/schemas/FELT"
          }
        },
        {
          "name": "to_address",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ETH_ADDRESS"
          }
        },
        {
          "name": "payload",
          "required": true,
          "schema": {
            "description": "The payload of the message",
            "title": "Payload",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FELT"
            }
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Hash of the consumed L2-to-L1 message",
        "schema": {
          "type": "object",
          "properties": {
            "message_hash": {
              "$ref": "#/components/schemas/HASH256"
            }
          },
          "required": ["message_hash"]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/MESSAGING_ERROR"
        }
      ]
    },
    {
      "name": "devnet_createBlock",
      "summary": "Create block",
      "params": [],
      "result": {
        "name": "result",
        "description": "New block hash",
        "schema": {
          "type": "object",
          "properties": {
            "block_hash": {
              "description": "Block hash",
              "$ref": "#/components/schemas/FELT"
            }
          },
          "required": ["block_hash"]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/WILDCARD_ERROR"
        }
      ]
    },
    {
      "name": "devnet_abortBlocks",
      "summary": "Abort blocks from starting_block_id to the currently latest block",
      "params": [
        {
          "name": "starting_block_id",
          "description": "The first block to be aborted.",
          "required": true,
          "schema": {
            "title": "Block id",
            "$ref": "#/components/schemas/BLOCK_ID"
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Array of block hashes of aborted blocks.",
        "schema": {
          "type": "object",
          "properties": {
            "aborted": {
              "description": "Aborted blocks hashes",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/FELT"
              }
            }
          },
          "required": ["aborted"]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/WILDCARD_ERROR"
        }
      ]
    },
    {
      "name": "devnet_acceptOnL1",
      "summary": "Simulate L1 acceptance up to and including starting_block_id",
      "params": [
        {
          "name": "starting_block_id",
          "description": "The newest block to accept on L1; preceding accepted-on-L2 blocks are also marked accepted on L1",
          "required": true,
          "schema": {
            "title": "Block id",
            "$ref": "#/components/schemas/BLOCK_ID"
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Array of locally generated Devnet block hashes accepted on L1.",
        "schema": {
          "type": "object",
          "properties": {
            "accepted": {
              "description": "Accepted local block hashes",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/FELT"
              }
            }
          },
          "required": ["accepted"]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/WILDCARD_ERROR"
        }
      ]
    },
    {
      "name": "devnet_setGasPrice",
      "summary": "Set gas price",
      "params": [
        {
          "name": "gas_price_wei",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/POSITIVE_GAS_PRICE"
          }
        },
        {
          "name": "data_gas_price_wei",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/POSITIVE_GAS_PRICE"
          }
        },
        {
          "name": "gas_price_fri",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/POSITIVE_GAS_PRICE"
          }
        },
        {
          "name": "data_gas_price_fri",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/POSITIVE_GAS_PRICE"
          }
        },
        {
          "name": "l2_gas_price_wei",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/POSITIVE_GAS_PRICE"
          }
        },
        {
          "name": "l2_gas_price_fri",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/POSITIVE_GAS_PRICE"
          }
        },
        {
          "name": "generate_block",
          "required": false,
          "schema": {
            "title": "Generate block",
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "All six configured gas prices, including unchanged values",
        "schema": {
          "type": "object",
          "properties": {
            "gas_price_wei": {
              "$ref": "#/components/schemas/POSITIVE_GAS_PRICE"
            },
            "data_gas_price_wei": {
              "$ref": "#/components/schemas/POSITIVE_GAS_PRICE"
            },
            "gas_price_fri": {
              "$ref": "#/components/schemas/POSITIVE_GAS_PRICE"
            },
            "data_gas_price_fri": {
              "$ref": "#/components/schemas/POSITIVE_GAS_PRICE"
            },
            "l2_gas_price_wei": {
              "$ref": "#/components/schemas/POSITIVE_GAS_PRICE"
            },
            "l2_gas_price_fri": {
              "$ref": "#/components/schemas/POSITIVE_GAS_PRICE"
            }
          },
          "required": [
            "gas_price_wei",
            "data_gas_price_wei",
            "gas_price_fri",
            "data_gas_price_fri",
            "l2_gas_price_wei",
            "l2_gas_price_fri"
          ]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/WILDCARD_ERROR"
        }
      ]
    },
    {
      "name": "devnet_restart",
      "summary": "Restarts devnet state",
      "params": [
        {
          "name": "restart_l1_to_l2_messaging",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Empty result",
        "schema": {
          "type": "object"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/WILDCARD_ERROR"
        }
      ]
    },
    {
      "name": "devnet_setTime",
      "summary": "Sets block.timestamp",
      "params": [
        {
          "name": "time",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/u64"
          }
        },
        {
          "name": "generate_block",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Configured timestamp and the new block hash, or null if no block was generated",
        "schema": {
          "type": "object",
          "properties": {
            "block_timestamp": {
              "$ref": "#/components/schemas/u64"
            },
            "block_hash": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/BLOCK_HASH"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["block_timestamp", "block_hash"]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/WILDCARD_ERROR"
        }
      ]
    },
    {
      "name": "devnet_increaseTime",
      "summary": "Increases block.timestamp",
      "params": [
        {
          "name": "time",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/u64"
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Timestamp increment and new block hash",
        "schema": {
          "type": "object",
          "properties": {
            "timestamp_increased_by": {
              "$ref": "#/components/schemas/u64"
            },
            "block_hash": {
              "$ref": "#/components/schemas/BLOCK_HASH"
            }
          },
          "required": ["timestamp_increased_by", "block_hash"]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/WILDCARD_ERROR"
        }
      ]
    },
    {
      "name": "devnet_getPredeployedAccounts",
      "summary": "Return predeployed accounts",
      "params": [
        {
          "name": "with_balance",
          "description": "Return balance of each predeployed account.",
          "required": false,
          "schema": {
            "title": "With balance",
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Predeployed accounts with optional balance information",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "initial_balance": {
                "type": "string",
                "title": "Initial balance"
              },
              "address": {
                "$ref": "#/components/schemas/ADDRESS",
                "title": "Account address"
              },
              "public_key": {
                "$ref": "#/components/schemas/FELT",
                "title": "Account public key"
              },
              "private_key": {
                "$ref": "#/components/schemas/FELT",
                "title": "Account private key"
              },
              "balance": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ACCOUNT_BALANCES"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "initial_balance",
              "address",
              "public_key",
              "private_key",
              "balance"
            ]
          }
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/WILDCARD_ERROR"
        }
      ]
    },
    {
      "name": "devnet_getAccountBalance",
      "summary": "Return account balance",
      "params": [
        {
          "name": "address",
          "description": "Account's balance.",
          "required": true,
          "schema": {
            "title": "Account address",
            "$ref": "#/components/schemas/ADDRESS"
          }
        },
        {
          "name": "unit",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/PRICE_UNIT"
          }
        },
        {
          "name": "block_id",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/BLOCK_ID"
          }
        }
      ],
      "result": {
        "name": "result",
        "description": "Account balance at the requested block; defaults to latest and FRI",
        "schema": {
          "$ref": "#/components/schemas/ACCOUNT_BALANCE"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/WILDCARD_ERROR"
        }
      ]
    },
    {
      "name": "devnet_mint",
      "summary": "Mints tokens to account.",
      "params": [
        {
          "name": "address",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ADDRESS"
          }
        },
        {
          "name": "amount",
          "required": true,
          "schema": {
            "type": "number",
            "minimum": 0
          },
          "description": "Amount in WEI or FRI; nonzero fractional parts of numbers are truncated"
        },
        {
          "name": "unit",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/PRICE_UNIT"
          },
          "description": "Defaults to FRI"
        }
      ],
      "result": {
        "name": "result",
        "description": "Decimal balance after minting and the executed transaction hash",
        "schema": {
          "type": "object",
          "properties": {
            "new_balance": {
              "type": "string"
            },
            "unit": {
              "$ref": "#/components/schemas/PRICE_UNIT"
            },
            "tx_hash": {
              "$ref": "#/components/schemas/TXN_HASH"
            }
          },
          "required": ["new_balance", "unit", "tx_hash"]
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/MINTING_REVERTED"
        }
      ]
    },
    {
      "name": "devnet_getConfig",
      "summary": "Return the resolved startup configuration",
      "params": [],
      "result": {
        "name": "result",
        "description": "Resolved startup configuration",
        "schema": {
          "type": "object",
          "properties": {
            "seed": {
              "type": "integer",
